# API Keys para el GPS Tracker
# Separadas por coma
# Ejemplo: API_KEYS="key1,key2,key3"
API_KEYS=dev-key-123,prod-key-456

# Nominatim (OSM) headers
# User-Agent requerido por la politica de Nominatim
NOMINATIM_USER_AGENT=gps-tracker/1.0 (contact: tu-email@dominio.com)
# Header From (email de contacto)
NOMINATIM_FROM=tu-email@dominio.com
# Idioma preferido (opcional)
NOMINATIM_ACCEPT_LANGUAGE=es-ES,es;q=0.9

# Opcional: Google Geocoding API Key
# Por defecto se usa OSM y ArcGIS (gratuitos)
# Si quieres usar Google Maps, descomenta y agrega tu clave:
# GOOGLE_API_KEY=tu_google_api_key_aqui
